# Command line argument parsing. Because the language has no keyword
# arguments, per-argument settings are passed as a dict (or `nil`):
#
#     var parser = ArgumentParser("tool", "Does things.");
#     parser.add_argument("path", nil);
#     parser.add_argument("--verbose", {"action": "store_true"});
#     parser.add_argument("--count", {"type": int, "default": 1});
#     var args = parser.parse_args(nil);   # nil parses os.argv[1:]
#
# Supported settings: "help", "default", "type" (a callable applied to
# the raw string), "action" ("store_true" / "store_false"), "required"
# (options only), "choices" (a list), "nargs" ("*", positionals only).
# `parse_args` returns a `Namespace` with one field per argument, or
# `nil` when it printed help because of `-h` / `--help`.
#
# Any token starting with `-` parses as an option, so a negative number
# cannot be passed as a positional value and there is no `--` separator
# to force positional parsing; route such values through an option
# (`--count -5` and `--count=-5` both work).

import "os";

# String literals carry no escape sequences, so the separator for help
# text is a literal newline inside a string.
const _NEWLINE = "
";

# The result object: `parse_args` sets one field per declared
# argument, named after its dest (`namespace.verbose`, `namespace.path`).
class Namespace {}

fun _basename(path) {
    var parts = path.split("/");
    var last = parts[len(parts) - 1];
    parts = last.split("\\");
    return parts[len(parts) - 1];
}

# The value for `key` from a settings dict that may be nil.
fun _setting(options, key, fallback) {
    if (options is nil) {
        return fallback;
    }
    return options.get(key, fallback);
}

# The field name for an argument: leading dashes stripped, inner ones
# turned into underscores.
fun _dest_name(name) {
    var stripped = name;
    while (stripped.startswith("-")) {
        stripped = stripped.removeprefix("-");
    }
    return stripped.replace("-", "_");
}

# One declared argument. A leading `-` in the name makes it an option
# (`--verbose value` or `--verbose=value`); otherwise it is a
# positional, filled left to right.
class _Argument {
    __init__(name, options) {
        # The user-facing spelling, e.g. "--mode" or "path". Used in
        # help output and error messages.
        this.name = name;
        this.is_option = name.startswith("-");
        # The field name on the result Namespace: dashes stripped and
        # inner ones turned into underscores ("--dry-run" -> dry_run).
        this.dest = _dest_name(name);
        # Free text for the help line; nil shows just the name.
        this.help = _setting(options, "help", nil);
        # Value used when the argument is not given. For options nil
        # means "absent is nil"; a positional without a default is
        # required.
        this.default_value = _setting(options, "default", nil);
        # A callable applied to each raw string value (e.g. `int`).
        this.type = _setting(options, "type", nil);
        # "store_true" / "store_false": the option takes no value and
        # stores the fixed bool; absent stores the opposite.
        this.action = _setting(options, "action", nil);
        # Options only: parsing fails when the option is not given.
        this.required = _setting(options, "required", false);
        # A list of allowed (converted) values.
        this.choices = _setting(options, "choices", nil);
        # Positionals only: "*" consumes all remaining tokens as a list.
        this.nargs = _setting(options, "nargs", nil);
        this._validate();
    }

    # Reject inconsistent settings at declaration time instead of
    # surfacing them as confusing parse results.
    _validate() {
        var name = this.name;
        if (!(this.action is nil) and this.action != "store_true" and this.action != "store_false") {
            var action = this.action;
            throw ValueError(f"unknown action for ${name}: ${action}");
        }
        if (this.is_option) {
            if (!(this.nargs is nil)) {
                throw ValueError(f"nargs is only supported for positional arguments: ${name}");
            }
            if (!(this.action is nil) and !(this.default_value is nil)) {
                throw ValueError(f"an action option always stores its fixed value and cannot take a default: ${name}");
            }
        } else {
            if (!(this.action is nil)) {
                throw ValueError(f"actions are only supported for options: ${name}");
            }
            if (this.required) {
                throw ValueError(f"required is only supported for options: ${name}");
            }
            if (!(this.nargs is nil) and this.nargs != "*") {
                var nargs = this.nargs;
                throw ValueError(f"unsupported nargs for ${name}: ${nargs}");
            }
        }
        if (!(this.choices is nil) and !(this.default_value is nil) and !(this.default_value in this.choices)) {
            var default_value = this.default_value;
            throw ValueError(f"default for ${name} is not one of the choices: ${default_value}");
        }
    }
}

# Declares the accepted arguments and parses a command line against
# them (see the module comment for the settings dict).
class ArgumentParser {
    __init__(prog, description) {
        # Program name for the usage line; nil derives it from
        # `os.argv[0]` (or "prog" in the REPL).
        this.prog = prog;
        # Free text shown between the usage line and the argument help.
        this.description = description;
        # Positional _Arguments in declaration order.
        this.positionals = [];
        # Option _Arguments keyed by their spelling ("--mode") for
        # lookup while parsing.
        this.options = {:};
        # Option _Arguments in declaration order, for help output and
        # default filling.
        this.option_list = [];
    }

    # Declare one argument; `options` is the settings dict or nil.
    # Throws ValueError on inconsistent settings or duplicate names.
    add_argument(name, options) {
        var argument = _Argument(name, options);
        if (this.options.contains(argument.name)) {
            throw ValueError(f"duplicate argument name: ${name}");
        }
        foreach (var existing in this.option_list) {
            if (existing.dest == argument.dest) {
                throw ValueError(f"duplicate argument name: ${name}");
            }
        }
        foreach (var existing in this.positionals) {
            if (existing.dest == argument.dest) {
                throw ValueError(f"duplicate argument name: ${name}");
            }
        }
        if (argument.is_option) {
            this.options[argument.name] = argument;
            this.option_list.append(argument);
        } else {
            # A greedy positional consumes every remaining token, so a
            # positional declared after it could never be filled.
            foreach (var existing in this.positionals) {
                if (existing.nargs == "*") {
                    var greedy = existing.name;
                    throw ValueError(f"positional ${name} can never be filled after the greedy ${greedy}");
                }
            }
            this.positionals.append(argument);
        }
        return argument;
    }

    # Parse the given argument list (`nil` for `os.argv[1:]`) into a
    # `Namespace`. Throws `ValueError` on invalid input; prints help and
    # returns `nil` on `-h` / `--help`.
    parse_args(args) {
        if (args is nil) {
            # os.argv without the leading script path.
            args = os.argv.copy();
            if (args) {
                args.pop(0);
            }
        }

        var result = Namespace();
        var seen = {:};
        var positional_index = 0;
        var index = 0;
        while (index < len(args)) {
            var token = args[index];
            if (token == "-h" or token == "--help") {
                this.print_help();
                return nil;
            }
            if (token.startswith("-") and token != "-") {
                index = this._parse_option(token, args, index, result, seen);
            } else {
                var indices = this._parse_positional(token, args, index, result, seen, positional_index);
                positional_index = indices[0];
                index = indices[1];
            }
            index = index + 1;
        }

        this._fill_missing_positionals(result, seen, positional_index);
        this._fill_missing_options(result, seen);
        return result;
    }

    # Handle one option token (optionally with an inline `=value`).
    # Returns the index of the last consumed token.
    _parse_option(token, args, index, result, seen) {
        var name = token;
        var inline_value = nil;
        if (token.contains("=")) {
            # Split only at the first "=": the name is the first piece
            # and the value is the remaining pieces rejoined, so the
            # value may itself contain "=" ("--sep=a=b" -> "a=b").
            var parts = token.split("=");
            name = parts[0];
            var rest = [];
            var part_index = 1;
            while (part_index < len(parts)) {
                rest.append(parts[part_index]);
                part_index = part_index + 1;
            }
            inline_value = "=".join(rest);
        }

        var argument = this.options.get(name, nil);
        if (argument is nil) {
            throw ValueError(f"unrecognized argument: ${name}");
        }

        var value = nil;
        if (argument.action == "store_true" or argument.action == "store_false") {
            if (!(inline_value is nil)) {
                throw ValueError(f"option ${name} takes no value");
            }
            value = argument.action == "store_true";
        } else {
            if (!(inline_value is nil)) {
                value = this._convert(argument, inline_value);
            } else {
                index = index + 1;
                if (index >= len(args)) {
                    throw ValueError(f"expected a value for option ${name}");
                }
                value = this._convert(argument, args[index]);
            }
        }
        setattr(result, argument.dest, value);
        seen[argument.dest] = true;
        return index;
    }

    # Handle one positional token. Returns a
    # `(next positional slot, last consumed token index)` tuple; a
    # greedy "*" argument consumes all remaining tokens.
    _parse_positional(token, args, index, result, seen, positional_index) {
        if (positional_index >= len(this.positionals)) {
            throw ValueError(f"unrecognized argument: ${token}");
        }
        var argument = this.positionals[positional_index];
        seen[argument.dest] = true;
        if (argument.nargs == "*") {
            var values = [];
            while (index < len(args)) {
                values.append(this._convert(argument, args[index]));
                index = index + 1;
            }
            setattr(result, argument.dest, values);
            return (positional_index + 1, index);
        }
        setattr(result, argument.dest, this._convert(argument, token));
        return (positional_index + 1, index);
    }

    _fill_missing_positionals(result, seen, positional_index) {
        while (positional_index < len(this.positionals)) {
            var argument = this.positionals[positional_index];
            if (!seen.contains(argument.dest)) {
                if (argument.nargs == "*") {
                    setattr(result, argument.dest, []);
                } else {
                    if (argument.default_value is nil) {
                        throw ValueError(f"missing required argument: ${argument.name}");
                    }
                    setattr(result, argument.dest, argument.default_value);
                }
            }
            positional_index = positional_index + 1;
        }
    }

    _fill_missing_options(result, seen) {
        foreach (var argument in this.option_list) {
            if (!seen.contains(argument.dest)) {
                if (argument.required) {
                    throw ValueError(f"missing required option: ${argument.name}");
                }
                if (argument.action == "store_true") {
                    setattr(result, argument.dest, false);
                } else {
                    if (argument.action == "store_false") {
                        setattr(result, argument.dest, true);
                    } else {
                        setattr(result, argument.dest, argument.default_value);
                    }
                }
            }
        }
    }

    _convert(argument, value) {
        if (!(argument.type is nil)) {
            value = argument.type(value);
        }
        if (!(argument.choices is nil) and !(value in argument.choices)) {
            var name = argument.name;
            var choices = argument.choices;
            throw ValueError(f"invalid choice for ${name}: ${value} (choose from ${choices})");
        }
        return value;
    }

    format_help() {
        var prog = this.prog;
        if (prog is nil) {
            prog = "prog";
            if (len(os.argv) > 0) {
                prog = _basename(os.argv[0]);
            }
        }
        var usage = f"usage: ${prog} [-h]";
        foreach (var argument in this.option_list) {
            usage = usage + f" [${argument.name}]";
        }
        foreach (var argument in this.positionals) {
            if (argument.nargs == "*") {
                usage = usage + f" [${argument.name} ...]";
            } else {
                usage = usage + f" ${argument.name}";
            }
        }
        var lines = [usage];
        if (!(this.description is nil)) {
            lines.append("");
            lines.append(this.description);
        }
        if (this.positionals) {
            lines.append("");
            lines.append("positional arguments:");
            foreach (var argument in this.positionals) {
                lines.append(this._help_line(argument));
            }
        }
        lines.append("");
        lines.append("options:");
        lines.append("  -h, --help - show this help message");
        foreach (var argument in this.option_list) {
            lines.append(this._help_line(argument));
        }
        return _NEWLINE.join(lines);
    }

    _help_line(argument) {
        if (argument.help is nil) {
            return f"  ${argument.name}";
        }
        return f"  ${argument.name} - ${argument.help}";
    }

    print_help() {
        print(this.format_help());
    }
}
