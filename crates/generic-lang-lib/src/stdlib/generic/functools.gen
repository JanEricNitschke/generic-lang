# Tools for working with functions and callables.
# `reduce` and `partial` come from the native half of the module and are
# re-exported here.

from "_functools" import reduce, partial;

# Turn a two-argument comparator (negative, zero, or positive result)
# into a key function usable with `sorted` and `list.sort`: the returned
# class wraps each element in an object whose comparisons consult the
# captured comparator.
fun cmp_to_key(cmp) {
    class Key {
        __init__(value) {
            this.value = value;
        }

        __lt__(other) {
            return cmp(this.value, other.value) < 0;
        }

        __le__(other) {
            return cmp(this.value, other.value) <= 0;
        }

        __gt__(other) {
            return cmp(this.value, other.value) > 0;
        }

        __ge__(other) {
            return cmp(this.value, other.value) >= 0;
        }

        __eq__(other) {
            return cmp(this.value, other.value) == 0;
        }
    }
    return Key;
}
