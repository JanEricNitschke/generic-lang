# Core builtin functions implemented in Generic language

# The root class. It carries no methods of its own; instances compare by
# identity and render as `<object instance>`. Chiefly useful as a unique,
# never-colliding sentinel via `object()`.
class object {}

fun all(iterable) {
    foreach (var item in iterable) {
        if (!item) {
            return false;
        }
    }
    return true;
}

fun any(iterable) {
    foreach (var item in iterable) {
        if (item) {
            return true;
        }
    }
    return false;
}

gen enumerate(iterable, start=0) {
    var index = start;
    foreach (var item in iterable) {
        yield (index, item);
        index = index + 1;
    }
}
fun abs(x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

fun bool(x) {
    return Bool(x);
}

fun sum(iterable, start=0) {
    var total = start;
    foreach (var item in iterable) {
        total = total + item;
    }
    return total;
}

fun min(iterable, key=nil) {
    var result = nil;
    var result_key = nil;
    var seen = false;
    foreach (var item in iterable) {
        var item_key = item;
        if (!(key is nil)) {
            item_key = key(item);
        }
        if (!seen or item_key < result_key) {
            result = item;
            result_key = item_key;
            seen = true;
        }
    }
    if (!seen) {
        throw ValueError("min() arg is an empty sequence");
    }
    return result;
}

fun max(iterable, key=nil) {
    var result = nil;
    var result_key = nil;
    var seen = false;
    foreach (var item in iterable) {
        var item_key = item;
        if (!(key is nil)) {
            item_key = key(item);
        }
        if (!seen or item_key > result_key) {
            result = item;
            result_key = item_key;
            seen = true;
        }
    }
    if (!seen) {
        throw ValueError("max() arg is an empty sequence");
    }
    return result;
}

fun reversed(iterable) {
    var items = [];
    foreach (var item in iterable) {
        items.append(item);
    }
    var result = [];
    var index = len(items) - 1;
    while (index >= 0) {
        result.append(items[index]);
        index = index - 1;
    }
    return result;
}

gen map(function, iterable) {
    foreach (var item in iterable) {
        yield function(item);
    }
}

gen zip(first, second) {
    var left = iter(first);
    var right = iter(second);
    while (true) {
        var a = next(left);
        if (a is StopIteration) {
            return;
        }
        var b = next(right);
        if (b is StopIteration) {
            return;
        }
        yield (a, b);
    }
}

gen filter(function, iterable) {
    foreach (var item in iterable) {
        if (function(item)) {
            yield item;
        }
    }
}
