# Coverage: int/float/rational on either side.
# Each group covers: positive, negative left, negative right, both negative.

# right operand: int
# int // int
print(5 // 2); # expect: 2
print(-7 // 2); # expect: -4
print(7 // -2); # expect: -4
print(-7 // -2); # expect: 3
# float // int
print(5.0 // 2); # expect: 2.0
print(-7.0 // 2); # expect: -4.0
print(7.0 // -2); # expect: -4.0
print(-7.0 // -2); # expect: 3.0
# rational // int
print((5:1) // 2); # expect: 2
print((-7:1) // 2); # expect: -4
print((7:1) // -2); # expect: -4
print((-7:1) // -2); # expect: 3

# right operand: float
# int // float
print(5 // 2.0); # expect: 2.0
print(-7 // 2.0); # expect: -4.0
print(7 // -2.0); # expect: -4.0
print(-7 // -2.0); # expect: 3.0
# float // float
print(5.0 // 2.0); # expect: 2.0
print(-7.0 // 2.0); # expect: -4.0
print(7.0 // -2.0); # expect: -4.0
print(-7.0 // -2.0); # expect: 3.0
# rational // float
print((5:1) // 2.0); # expect: 2.0
print((-7:1) // 2.0); # expect: -4.0
print((7:1) // -2.0); # expect: -4.0
print((-7:1) // -2.0); # expect: 3.0

# right operand: rational
# int // rational
print(5 // (2:1)); # expect: 2
print(-7 // (2:1)); # expect: -4
print(7 // (-2:1)); # expect: -4
print(-7 // (-2:1)); # expect: 3
# float // rational
print(5.0 // (2:1)); # expect: 2.0
print(-7.0 // (2:1)); # expect: -4.0
print(7.0 // (-2:1)); # expect: -4.0
print(-7.0 // (-2:1)); # expect: 3.0
# rational // rational
print((5:1) // (2:1)); # expect: 2
print((-7:1) // (2:1)); # expect: -4
print((7:1) // (-2:1)); # expect: -4
print((-7:1) // (-2:1)); # expect: 3

# non-whole operands
# right operand: int
# float // int
print(5.5 // 2); # expect: 2.0
print(-7.5 // 2); # expect: -4.0
print(7.5 // -2); # expect: -4.0
print(-7.5 // -2); # expect: 3.0
# rational // int
print((11:2) // 2); # expect: 2
print((-15:2) // 2); # expect: -4
print((15:2) // -2); # expect: -4
print((-15:2) // -2); # expect: 3

# right operand: float
# int // float
print(5 // 2.25); # expect: 2.0
print(-7 // 2.25); # expect: -4.0
print(7 // -2.25); # expect: -4.0
print(-7 // -2.25); # expect: 3.0
# float // float
print(5.5 // 2.25); # expect: 2.0
print(-7.5 // 2.25); # expect: -4.0
print(7.5 // -2.25); # expect: -4.0
print(-7.5 // -2.25); # expect: 3.0
# rational // float
print((11:2) // 2.25); # expect: 2.0
print((-15:2) // 2.25); # expect: -4.0
print((15:2) // -2.25); # expect: -4.0
print((-15:2) // -2.25); # expect: 3.0

# right operand: rational
# int // rational
print(5 // (9:4)); # expect: 2
print(-7 // (9:4)); # expect: -4
print(7 // (-9:4)); # expect: -4
print(-7 // (-9:4)); # expect: 3
# float // rational
print(5.5 // (9:4)); # expect: 2.0
print(-7.5 // (9:4)); # expect: -4.0
print(7.5 // (-9:4)); # expect: -4.0
print(-7.5 // (-9:4)); # expect: 3.0
# rational // rational
print((11:2) // (9:4)); # expect: 2
print((-15:2) // (9:4)); # expect: -4
print((15:2) // (-9:4)); # expect: -4
print((-15:2) // (-9:4)); # expect: 3

# BigInt
print(9223372036854775808 // 3); # expect: 3074457345618258602
print(-9223372036854775809 // 2); # expect: -4611686018427387905
print(2 // "Test"); # expect runtime error: TypeError: Operands must be numbers or support `__floor_div__`. Got: [2, Test]
