print(2 ** 62); # expect: 4611686018427387904
print(2 ** 63); # expect: 9223372036854775808
print(2 ** 100); # expect: 1267650600228229401496703205376
print((-2) ** 63); # expect: -9223372036854775808
print(3 ** 40); # expect: 12157665459056928801
print((-3) ** 41); # expect: -36472996377170786403
print((3:2) ** 40); # expect: 12157665459056928801:1099511627776
