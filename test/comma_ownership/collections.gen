var list = [1, ->() 2, 3];
print(len(list));
print(list[1]());

var set = {1, ->() 2, 3};
print(len(set));

var tuple = (1, ->() 2, 3);
print(len(tuple));
print(tuple[1]());

var dict = {1: ->() 2, 3: 4};
print(len(dict));
print(dict[1]());
