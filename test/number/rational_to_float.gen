# float() of a rational whose numerator or denominator overflows f64 still
# yields the correctly-scaled f64: neither a spurious inf when the true ratio
# is a representable finite value, nor a spurious 0 when a small component
# would be lost to a naive rescaling.

# A large finite ratio: the numerator overflows f64, but divided by 7 the value
# is about 1.43e308, well within range.
var large = float( : 7);
print(large > .0 and large < .0); # expect: true

# A negative numerator keeps its sign.
var negative = float((0 - ) : 7);
print(negative < 0.0 and negative > (0.0 - .0)); # expect: true

# Both components overflow f64 yet are coprime, so neither reduces away; the
# ratio is about 100000.
var both = float( : );
print(both > 99999.0 and both < 100001.0); # expect: true

# A tiny ratio stays a nonzero subnormal instead of collapsing to 0.
var tiny = float(1 : );
print(tiny > 0.0 and tiny < 1.0); # expect: true

# A genuinely oversized ratio saturates to the same infinity no matter how far
# past f64::MAX it reaches.
print(float( : 3) == float( : 3)); # expect: true

# A genuinely undersized ratio underflows to 0.
print(float(1 : ) == 0.0); # expect: true
