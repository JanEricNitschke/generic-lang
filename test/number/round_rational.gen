# round() on a rational uses exact integer arithmetic (ties to even), so it is
# correct even where the exact value differs from its nearest f64, and it
# handles rationals too large for f64. Rational literals: 5:2 is five halves.

# Halves tie to the even neighbour.
print(round(5:2)); # expect: 2
print(round(7:2)); # expect: 4
print(round(-5:2)); # expect: -2

# Non-halves round to the nearest integer.
print(round(1:3)); # expect: 0
print(round(2:3)); # expect: 1

# Just above an exact half: lossy f64 rounding would give 2, exact gives 3.
print(round(50000000000000001 : 20000000000000000)); # expect: 3

# A rational with a big-integer numerator rounds by exact arithmetic (the
# result itself is a big integer); 2**64+1 over 2 ties to the even neighbour.
print(round(20000000000000000001 : 2)); # expect: 10000000000000000000
