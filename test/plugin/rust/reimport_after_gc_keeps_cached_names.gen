# Imports are cached by module identity: the local from-import inside the
# function builds the plugin module once, and the module cache keeps it
# (with every export, not just the names literally imported) alive across
# a collection after the function returned. The later top-level import
# binds that same module without rebuilding it, so its ids must have
# survived the GC (a deterministic arena panic under the stress-GC
# profile otherwise).
#
# Exports exercised here:
#   add(a, b) -- via the local from-import inside the function
#   shout(s)  -- via the cache-hit re-import at top level
fun use_add_locally() {
    from "rust_demo_plugin" import add;
    return add(1, 2);
}
print(use_add_locally()); # expect: 3

# Cache-hit re-import; call an export that was NOT in the from-import above.
import "rust_demo_plugin";
print(rust_demo_plugin.shout("ok")); # expect: OK!
