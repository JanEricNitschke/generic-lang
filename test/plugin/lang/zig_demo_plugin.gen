# Zig plugin fixture (plugin-examples/zig/zig_demo_plugin.zig), built by the
# Makefile `plugin-lang-fixture` step through its build.zig, which translates
# the generated C header into a Zig module. Same ABI, exercised from Zig.
#
# Exports exercised here:
#   add(a, b)                  -- integer addition
#   shout(s)                   -- ASCII-uppercase the string, append "!"
#   raise(class_name, message) -- throw a fresh instance of the named class
import "zig_demo_plugin";

print(zig_demo_plugin.add(40, 2)); # expect: 42
print(zig_demo_plugin.shout("hi zig")); # expect: HI ZIG!

try {
    zig_demo_plugin.raise("ValueError", "from zig");
} catch ValueError as e {
    print("caught: " + str(e)); # expect: caught: from zig
}

try {
    zig_demo_plugin.add("x", "y");
} catch TypeError as e {
    print("type: " + str(e)); # expect: type: zig_demo_plugin.add expects two ints
}

# --- the Counter plugin class (same shape as the Rust example) ---
var c = zig_demo_plugin.Counter("hello");
print(c.value());       # expect: 0
print(c.increment());   # expect: 1
print(c.increment());   # expect: 2
print(c.label());       # expect: hello
print(c.origin);        # expect: counter
c.set_note("note!");
print(c.get_note());    # expect: note!
print(c.note);          # expect: note!
print(isinstance(c, zig_demo_plugin.Counter)); # expect: true

# a dunder implemented by the plugin class
var d = zig_demo_plugin.Counter("x");
d.increment();
print((c + d).value());  # expect: 3

# a user subclass inherits the plugin backing, methods, and dunders
var Counter = zig_demo_plugin.Counter;
class Sub < Counter {
    __init__(label) { super.__init__(label); }
}
var s = Sub("sub");
s.increment();
print(s.value());       # expect: 1
print(s.label());       # expect: sub
print((c + s).value());  # expect: 3
print(isinstance(s, zig_demo_plugin.Counter)); # expect: true

# --- the held label survives collections (traverse) ---
var listed = zig_demo_plugin.Counter([1, 2, 3]);
print(listed.label());  # expect: [1, 2, 3]

# --- module values, built once at import time ---
print(zig_demo_plugin.golden_ratio);  # expect: 1.618033988749895
