# C plugin fixture (plugin-examples/c/c_demo_plugin.c), built by the Makefile
# `plugin-lang-fixture` step. Same ABI as the Rust plugin, exercised from
# plain C.
#
# Exports exercised here:
#   add(a, b)                  -- integer addition
#   shout(s)                   -- ASCII-uppercase the string, append "!"
#   raise(class_name, message) -- throw a fresh instance of the named class
#   empty_string()             -- build "" inside the plugin (non-null, len 0)
import "c_demo_plugin";

print(c_demo_plugin.add(40, 2)); # expect: 42
print(c_demo_plugin.shout("hi there")); # expect: HI THERE!

print(c_demo_plugin.empty_string() == ""); # expect: true
print(c_demo_plugin.shout(c_demo_plugin.empty_string())); # expect: !

try {
    c_demo_plugin.raise("KeyError", "boom");
} catch KeyError as e {
    print("caught: " + str(e)); # expect: caught: boom
}

try {
    c_demo_plugin.add("x", "y");
} catch TypeError as e {
    print("type: " + str(e)); # expect: type: c_demo_plugin.add expects two ints
}

# --- the Counter plugin class (same shape as the Rust example) ---
var c = c_demo_plugin.Counter("hello");
print(c.value());       # expect: 0
print(c.increment());   # expect: 1
print(c.increment());   # expect: 2
print(c.label());       # expect: hello
print(c.origin);        # expect: counter
c.set_note("note!");
print(c.get_note());    # expect: note!
print(c.note);          # expect: note!
print(isinstance(c, c_demo_plugin.Counter)); # expect: true

# a dunder implemented by the plugin class
var d = c_demo_plugin.Counter("x");
d.increment();
print((c + d).value());  # expect: 3

# a user subclass inherits the plugin backing, methods, and dunders
var Counter = c_demo_plugin.Counter;
class Sub < Counter {
    __init__(label) { super.__init__(label); }
}
var s = Sub("sub");
s.increment();
print(s.value());       # expect: 1
print(s.label());       # expect: sub
print((c + s).value());  # expect: 3
print(isinstance(s, c_demo_plugin.Counter)); # expect: true

# --- the held label survives collections (traverse) ---
var listed = c_demo_plugin.Counter([1, 2, 3]);
print(listed.label());  # expect: [1, 2, 3]
