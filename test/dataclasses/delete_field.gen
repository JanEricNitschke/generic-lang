from "dataclasses" import dataclass;

# Deleting a class variable does not shrink the frozen field list: the
# generated methods still expect the field, so its default is gone and
# instances must provide it.
@dataclass
class Point {
    var x;
    var y = 0;
}

print(Point(1)); # expect: Point(x=1, y=0)
delattr(Point, "y");
print(Point(1, 2)); # expect: Point(x=1, y=2)
try {
    Point(1);
} catch TypeError as e {
    print(e.message()); # expect: Missing argument for field `y` without a default.
}

# Class variables deleted before decoration keep the remaining
# declaration order.
class Wide {
    var a;
    var b = 1;
    var c = 2;
}

delattr(Wide, "b");
dataclass(Wide);
print(Wide.__dataclass_fields__); # expect: (a, c)
print(Wide(1, 3)); # expect: Wide(a=1, c=3)

# Deleting the frozen field list itself unmakes the dataclass: the
# generated methods refuse to run.
delattr(Point, "__dataclass_fields__");
try {
    Point(1, 2);
} catch TypeError as e {
    print(e.message()); # expect: 'Point' is not a dataclass.
}
