from "collections" import Deque;

var d = Deque([2, 3]);
d.append(4);
d.appendleft(1);
print(d); # expect: Deque([1, 2, 3, 4])
print(len(d)); # expect: 4
print(d.pop()); # expect: 4
print(d.popleft()); # expect: 1
print(d); # expect: Deque([2, 3])
print(2 in d); # expect: true
print(9 in d); # expect: false

foreach (var item in d) {
    print(item);
} # expect: 2
# expect: 3

print(d == Deque([2, 3])); # expect: true
print(d == Deque([3, 2])); # expect: false
print(d == [2, 3]); # expect: false

var alternating = Deque(nil);
print(Bool(alternating)); # expect: false
alternating.appendleft("b");
alternating.appendleft("a");
alternating.append("c");
print(alternating.popleft()); # expect: a
print(alternating.popleft()); # expect: b
print(alternating.popleft()); # expect: c
print(Bool(alternating)); # expect: false

d.clear();
print(len(d)); # expect: 0
