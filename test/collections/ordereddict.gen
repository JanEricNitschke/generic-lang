from "collections" import OrderedDict;

var d = OrderedDict();
d["banana"] = 2;
d["apple"] = 1;
d["cherry"] = 3;
print(d); # expect: OrderedDict({banana: 2, apple: 1, cherry: 3})
# The views are lazy, like the base dict's; materialize to inspect.
print(List(d.keys())); # expect: [banana, apple, cherry]
print(List(d.values())); # expect: [2, 1, 3]
print(List(d.items())); # expect: [(banana, 2), (apple, 1), (cherry, 3)]
print(d["apple"]); # expect: 1

# Overwriting keeps the original position.
d["banana"] = 20;
print(List(d.keys())); # expect: [banana, apple, cherry]
print(d["banana"]); # expect: 20

foreach (var key in d) {
    print(key);
} # expect: banana
# expect: apple
# expect: cherry

print(d.pop("apple")); # expect: 1
print(List(d.keys())); # expect: [banana, cherry]

# Reinserting a removed key appends it at the end.
d["apple"] = 5;
print(List(d.keys())); # expect: [banana, cherry, apple]

d.clear();
print(len(d)); # expect: 0
print(d); # expect: OrderedDict({:})

# Equality: order-sensitive against another OrderedDict, content-only
# against a plain Dict.
var left = OrderedDict();
left["a"] = 1;
left["b"] = 2;
var same_order = OrderedDict();
same_order["a"] = 1;
same_order["b"] = 2;
var other_order = OrderedDict();
other_order["b"] = 2;
other_order["a"] = 1;
print(left == same_order); # expect: true
print(left == other_order); # expect: false
print(left == {"b": 2, "a": 1}); # expect: true
print(left == {"a": 1}); # expect: false
