# Equal paths (equal normalized forms) hash equal, so paths behave as
# set members and dict keys.
from "pathlib" import Path;

print(hash(Path("a/b")) == hash(Path("a/b"))); # expect: true
print(hash(Path("a/./b/")) == hash(Path("a/b"))); # expect: true

var seen = {Path("a/b"), Path("a/./b")};
print(len(seen)); # expect: 1

var sizes = {Path("src"): 10};
print(sizes[Path("./src")]); # expect: 10

# Distinct paths land in distinct entries.
var both = {Path("a"), Path("b")};
print(len(both)); # expect: 2
