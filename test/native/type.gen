# `type(x)` returns the class of a value (instances and the value-type proxies),
# comparable by identity; it raises for values that have no class.
class Tree {
  stuff() {}
}

print(type(5) == Integer); # expect: true
print(type(3.2) == Float); # expect: true
print(type("Test") == String); # expect: true
print(type(true) == Bool); # expect: true
print(type(nil) == NilType); # expect: true
print(type(Tree()) == Tree); # expect: true
print(type([1, 2, 3]) == List); # expect: true
print(type(5) == String); # expect: false
print(isinstance(5, type(5))); # expect: true
print(isinstance(nil, NilType)); # expect: true

# NilType is constructible and yields the sole nil value.
print(NilType() == nil); # expect: true

# The StopIteration sentinel maps to StopIterationType
var stop = next(iter([]));
print(type(stop) == StopIterationType); # expect: true
print(isinstance(stop, StopIterationType)); # expect: true
print(StopIterationType() == StopIteration); # expect: true

# type() still raises for values that have no class.
try {
    type(Tree);
} catch TypeError as e {
    print(e); # expect: type() is not defined for <type class>
}
try {
    type(print);
} catch TypeError as e {
    print(e); # expect: type() is not defined for <type native function>
}
