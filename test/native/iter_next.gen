var my_list = [1, 2, 3];

var my_list_iter = iter(my_list);
print(my_list_iter); # expect: <list iterator of [1, 2, 3]>
print(next(my_list_iter)); # expect: 1
print(next(my_list_iter)); # expect: 2
print(next(my_list_iter)); # expect: 3
print(next(my_list_iter)); # expect: StopIteration

# With a default argument, a spent iterator yields the default instead.
print(next(my_list_iter, "done")); # expect: done
print(next(iter([7]), "done")); # expect: 7
