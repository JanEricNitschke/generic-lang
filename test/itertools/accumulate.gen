from "itertools" import accumulate;

print(List(accumulate([1, 2, 3, 4], nil))); # expect: [1, 3, 6, 10]
print(List(accumulate([], nil))); # expect: []
print(List(accumulate([5], nil))); # expect: [5]
print(List(accumulate(["a", "b", "c"], nil))); # expect: [a, ab, abc]

fun max2(a, b) {
    if (a > b) {
        return a;
    }
    return b;
}

print(List(accumulate([3, 1, 4, 1, 5, 2], max2))); # expect: [3, 3, 4, 4, 5, 5]
print(List(accumulate(1..<5, (->(a, b) a * b)))); # expect: [1, 2, 6, 24]
