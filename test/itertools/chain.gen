from "itertools" import chain;

print(List(chain([[1, 2], [3], [4, 5]]))); # expect: [1, 2, 3, 4, 5]
print(List(chain([]))); # expect: []
print(List(chain([[], [1], []]))); # expect: [1]
print(List(chain(["ab".chars(), "cd".chars()]))); # expect: [a, b, c, d]
print(List(chain([1..<3, 5..<7]))); # expect: [1, 2, 5, 6]
