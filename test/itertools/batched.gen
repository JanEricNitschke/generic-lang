from "itertools" import batched;

print(List(batched([1, 2, 3, 4, 5, 6], 2))); # expect: [(1, 2), (3, 4), (5, 6)]
print(List(batched([1, 2, 3, 4, 5], 2))); # expect: [(1, 2), (3, 4), (5,)]
print(List(batched([1, 2], 5))); # expect: [(1, 2)]
print(List(batched([], 3))); # expect: []
print(List(batched("abcde".chars(), 2))); # expect: [(a, b), (c, d), (e,)]
