import "disassembler";
import "string";

fun lazy(a, b=>a + 1) {
    return b;
}

var lines = disassembler.disassemble(lazy).split(string.newline);
foreach (var line in lines) {
    if (line != "") {
        print(line.strip());
    }
}

# expect: == lazy ==
# expect: 0000    4 OP_ARG_SUPPLIED                1
# expect: 0002    | OP_POP_JUMP_IF_TRUE            2 -> 12
# expect: 0005    4 OP_GET_LOCAL                   1
# expect: 0007    4 OP_LOAD_ONE
# expect: 0008    4 OP_ADD
# expect: 0009    4 OP_SET_LOCAL                   2
# expect: 0011    | OP_POP
# expect: 0012    5 OP_GET_LOCAL                   2
# expect: 0014    | OP_RETURN
# expect: 0015    4 OP_NIL
# expect: 0016    | OP_RETURN

gen lazy_gen(a=>1) {
    yield a;
}
var gen_lines = disassembler.disassemble(lazy_gen).split(string.newline);
foreach (var line in gen_lines) {
    if (line != "") {
        print(line.strip());
    }
}

# expect: == lazy_gen ==
# expect: 0000   28 OP_RETURN_GENERATOR
# expect: 0001   28 OP_ARG_SUPPLIED                0
# expect: 0003    | OP_POP_JUMP_IF_TRUE            3 -> 10
# expect: 0006   28 OP_LOAD_ONE
# expect: 0007   28 OP_SET_LOCAL                   1
# expect: 0009    | OP_POP
# expect: 0010   29 OP_GET_LOCAL                   1
# expect: 0012   29 OP_YIELD
# expect: 0013   29 OP_POP
# expect: 0014   28 OP_STOP_ITERATION
# expect: 0015    | OP_RETURN
